{
  "name": "interteste-agent",
  "version": "2.1.8",
  "description": "Agente local para comunicação Modbus TCP/RTU e CANopen/CAN via USB-CAN do InterTeste",
  "main": "index.js",
  "bin": "index.js",
  "scripts": {
    "start": "node index.js",
    "build:win": "pkg index.js --targets node18-win-x64 --output dist/InterTeste-Agent-v2.1.2.exe",
    "build:linux": "pkg index.js --targets node18-linux-x64 --output dist/interteste-agent-linux-v2.1.2",
    "build": "npm run build:win && npm run build:linux"
  },
  "keywords": [
    "modbus",
    "tcp",
    "rtu",
    "serial",
    "canopen",
    "can",
    "socketcan",
    "slcan",
    "interteste",
    "vacon",
    "weg"
  ],
  "author": "Interface Automação",
  "license": "MIT",
  "dependencies": {
    "ws": "^8.18.0",
    "modbus-serial": "^8.0.17",
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "pkg": {
    "assets": [
      "node_modules/**/*"
    ],
    "scripts": [
      "node_modules/serialport/**/*.js",
      "node_modules/modbus-serial/**/*.js"
    ],
    "targets": [
      "node18-win-x64",
      "node18-linux-x64"
    ]
  }
}
