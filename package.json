{
  "name": "interteste-agent",
  "version": "1.0.0",
  "description": "Agente local para comunicação Modbus TCP/RTU do InterTeste",
  "main": "index.js",
  "bin": "index.js",
  "scripts": {
    "start": "node index.js",
    "build": "pkg . --targets node18-win-x64,node18-linux-x64 --output dist/interteste-agent"
  },
  "keywords": ["modbus", "tcp", "rtu", "serial", "interteste"],
  "author": "Interface Automação",
  "license": "MIT",
  "dependencies": {
    "ws": "^8.18.0",
    "modbus-serial": "^8.0.17",
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "pkg": {
    "assets": ["node_modules/**/*"],
    "targets": ["node18-win-x64", "node18-linux-x64"]
  }
}
